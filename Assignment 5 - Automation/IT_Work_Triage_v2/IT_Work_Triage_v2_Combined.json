    {
      "parameters": {
        "jsCode": "const r=$input.first().json,p=r.body??{},i=$('Validate Input').first().json,c=$('Check Model Response').first().json.classification,a=$('Check Alignment Response').first().json.alignment;\nconst ok=r.statusCode===200&&p.request_id===i.request_id&&['P1','P2','P3','P4','Undetermined'].includes(p.priority)&&typeof p.review_required==='boolean'&&typeof p.provisional==='boolean'&&Array.isArray(p.reasons)&&p.production_authorized===false;\nconst reasons=[];if(c.prediction_code===1)reasons.push('Classifier recommends escalation');if(a.alignment_status!=='Aligned'||a.review_required)reasons.push('Document alignment requires review');if(!ok)reasons.push('Priority service response invalid');else if(p.review_required||p.provisional||!['P3','P4'].includes(p.priority))reasons.push('Priority assessment requires review');\nreturn [{json:{request_id:i.request_id,classification:c,alignment:a,priority:ok?p:null,review_required:reasons.length>0,review_reasons:reasons,status:ok?'assessed':'manual_review',http_status:ok?200:503,advisory_only:true,production_authorized:false,assessed_at:new Date().toISOString()}}];"
