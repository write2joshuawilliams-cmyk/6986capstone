        "jsCode": "const b=$input.first().json.body ?? {};\nconst id=typeof b.request_id==='string'?b.request_id.trim():'';\nconst text=typeof b.scenario_text==='string'?b.scenario_text.trim():'';\nconst domain=b.domain??null;\nconst fields={impact:['low','medium','high','unknown'],urgency:['low','medium','high','unknown'],critical_outage:['yes','no','unknown'],active_security_incident:['yes','no','unknown'],critical_recovery_failure:['yes','no','unknown']};\nconst risk={}; let valid=id.length>0&&id.length<=100&&text.length>=5&&text.length<=10000&&(domain===null||(typeof domain==='string'&&domain.length<=100));\nfor(const [k,allowed] of Object.entries(fields)){risk[k]=b[k]===undefined?'unknown':b[k];if(!allowed.includes(risk[k]))valid=false;}\nreturn [{json:{valid,request_id:id,scenario_text:text,domain,...risk}}];"
