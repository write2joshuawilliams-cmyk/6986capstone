    {
      "parameters": {
        "jsCode": "const r=$input.first().json; const b=r.body ?? {}; const id=$('Validate Input').first().json.request_id;\nconst base={request_id:id,logged_at:new Date().toISOString(),advisory_only:true,production_authorized:false};\nif(r.statusCode!==200 || !['scored','duplicate'].includes(b.status) || ![0,1].includes(b.prediction_code) || b.request_id!==id || b.model_sha256!=='e7e440cacfc5926e4eab482bc9baad188eebedf2dbab22b21b3d49fcffac4239') return [{json:{...base,status:'manual_review',route:'service_error',review_required:true,http_status:503,message:'Model response unavailable or invalid. Do not proceed.'}}];\nreturn [{json:{...base,status:b.status, prediction:b.prediction,prediction_code:b.prediction_code,confidence:b.confidence,model_version:b.model_version,model_sha256:b.model_sha256,route:b.status==='duplicate'?'duplicate':b.prediction_code===1?'human_review':'routine_advisory',review_required:b.status!=='duplicate'&&b.prediction_code===1,http_status:200}}];"
      },
