    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst id = typeof b.request_id === 'string' ? b.request_id.trim() : '';\nconst text = typeof b.scenario_text === 'string' ? b.scenario_text.trim() : '';\nconst domain = b.domain ?? null;\nconst valid = id.length > 0 && id.length <= 100 && text.length >= 5 && text.length <= 10000 && (domain === null || (typeof domain === 'string' && domain.length <= 100));\nreturn [{json:{valid, request_id:id, scenario_text:text, domain}}];"
      },
