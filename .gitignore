# ==========================================
# Agency Data & Sensitive Material Protection
# ==========================================
# Raw policy documents, PDFs, DOCX, and text extractions
data/raw/
data/sanitized/
*.pdf
*.docx
*.doc
*.txt
*.csv
*.json
*.xlsx

# Allow intentional project artifacts
!evaluation/*.csv
!evaluation/*.json
!configs/*.json
!artifacts/*.csv
!artifacts/*.json
!n8n/*.json

# Environment variables & API credentials
.env
.env.*
*.pem
*.key


# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================
# n8n & Local Artifacts
# ==========================================
n8n_data/
logs/
*.log
